#!/bin/sh
# Build systemd-compose as a static binary and put it on PATH.
#
#   ./install              -> ~/.local/bin/systemd-compose
#   ./install /usr/local/bin
#
# Needs a Go toolchain (go.dev/dl). The binary has no runtime dependency,
# not even glibc: copy it to a machine without Go and it runs.
set -eu
dir=$(cd "$(dirname "$0")" && pwd)
dest=${1:-$HOME/.local/bin}
if ! command -v go >/dev/null 2>&1; then
	echo "install: go is not on PATH; install a toolchain from https://go.dev/dl or copy a built systemd-compose binary to $dest" >&2
	exit 1
fi
mkdir -p "$dest"
CGO_ENABLED=0 go build -C "$dir" -trimpath -ldflags='-s -w' -o "$dest/systemd-compose" .
echo "install: $dest/systemd-compose ($(go version | cut -d' ' -f3), static)"
case ":$PATH:" in *":$dest:"*) ;; *) echo "install: note: $dest is not on your PATH" >&2 ;; esac
