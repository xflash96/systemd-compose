#!/bin/bash
# ci/live — drive systemd-compose through a throwaway project on the REAL
# user manager, and check that nothing is left behind.
#
#   ci/live                 build from this checkout, then test it
#   SC=/path/to/bin ci/live test that binary instead
#
# Needs a user manager (systemctl --user; waited for up to 60 s, for one
# that lingering just started) on cgroup v2, systemd's tools, bash, sh,
# coreutils, grep, sed, awk, and a Go toolchain unless SC names a binary.
# The project gets a name no one else uses and is taken down on any exit,
# so a failure leaves no unit behind. Prints the versions under test, then
# one line per check (ok or FAIL); exit 1 on any FAIL.
set -uo pipefail
# The tool's own overrides (SYSTEMD_COMPOSE_*) would rename the project,
# or change its profiles, away from the throwaway one this script cleans up.
# Quoted, like "$@": no names, no words (bash 5.1 and 5.2).
unset "${!SYSTEMD_COMPOSE_@}"

here=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d)
name=sdclive$$
fails=0

ok()   { printf 'ok    %s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*"; fails=$((fails + 1)); }
# A check is a label and a command. Never a redirect on the check line:
# bash opens it before check runs, so a missing file skips the check with
# no line and no count; name the file as an argument.
check() { local what=$1; shift; if "$@" >/dev/null 2>&1; then ok "$what"; else fail "$what"; fi; }

if [ -z "${SC:-}" ]; then
	(cd "$here" && CGO_ENABLED=0 go build -o "$work/systemd-compose" .) || { echo "build failed"; exit 1; }
	SC=$work/systemd-compose
fi
sc() { (cd "$work/p" && "$SC" "$@"); }
unitdir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user # Manager.UnitDir (manager.go)

cleanup() {
	sc down >/dev/null 2>&1
	rm -f "$unitdir"/"$name"[-.]* 2>/dev/null
	systemctl --user stop "$name.slice" >/dev/null 2>&1
	systemctl --user reset-failed "$name*" >/dev/null 2>&1
	rm -rf "$work"
}
trap cleanup EXIT

for _ in $(seq 60); do
	systemctl --user show -p Version >/dev/null 2>&1 && break
	sleep 1
done
systemctl --user show -p Version >/dev/null 2>&1 || { echo "no user manager here (systemctl --user)"; exit 1; }
[ -f /sys/fs/cgroup/cgroup.controllers ] || { echo "needs cgroup v2 (job's build reads the slice's memory.max)"; exit 1; }
echo "$("$SC" --version | tr '\n' ' ')"

mkdir -p "$work/p" && cd "$work/p"
echo "GREETING=hello" > .env
write() { # the project: web's X, an optional extra service, the project's memory cap
	cat > systemd-compose.yaml <<EOF
name: $name
resources: {memory: ${3:-256M}}
x-base: &base
  restart: unless-stopped
services:
  web:
    <<: *base
    command: [sh, -c, 'echo "web X=\$\$X G=\$\$G RT=\$\$RT fds=\$\$LISTEN_FDS"; exec sleep infinity']
    environment: {X: "$1", G: "\${GREETING}", RT: "%t/$name"}
    listen: "%t/$name.sock"
    healthcheck: {test: [true], interval: 1s}
  job:
    command: [sh, -c, "echo job ran"]
    schedule: "*-*-* 04:00:00"
    build: {run: ["sh -c 'cat /proc/self/cgroup > built; cat /sys/fs/cgroup\$\$(dirname \$\$(cut -d: -f3 /proc/self/cgroup))/memory.max >> built'"], creates: built}
  debug:
    command: sleep infinity
    profiles: [debug]
$2
EOF
}
units() { systemctl --user list-units --all --plain --no-legend "$name*" | wc -l; }
links() { ls -A "$unitdir" 2>/dev/null | grep -c "^$name[-.]"; }
active() { [ "$(systemctl --user is-active "$1")" = active ]; }
pid() { systemctl --user show -p MainPID --value "$1"; }
inactive() { ! active "$1"; }
refuses() { ! sc "$@"; }
exits() { local want=$1; shift; sc "$@"; [ $? = "$want" ]; }
# shows PATTERN CMD...: CMD succeeds and its output matches. Captured
# first: `CMD | grep -q` under pipefail fails when grep exits early and
# CMD dies writing the rest (SIGPIPE).
shows() { local pat=$1 out; shift; out=$("$@") || return 1; grep -q -- "$pat" <<<"$out"; }
says() { local pat=$1 out; shift; out=$("$@" 2>&1); grep -q -- "$pat" <<<"$out"; } # whatever CMD's exit
# The two lines of printVersion (version.go).
versions() { "$SC" version | awk 'NR==1 && /^systemd-compose / {a=1} NR==2 && /^systemd [0-9]/ {b=1} END {exit !(a && b)}'; }
# %t is the user manager's runtime dir, which it reports itself.
runtime_dir() { local d; d=$(systemctl --user show-environment | sed -n 's/^XDG_RUNTIME_DIR=//p'); echo "${d:-/run/user/$(id -u)}"; }
all_unchanged() { # the plan has rows for the project, and every one says unchanged (row grammar: up in cli.go)
	local plan
	plan=$(sc up | grep -E "^  $name[-.]") || return 1
	! grep -qvE "^  $name[-.][^ ]* +unchanged " <<<"$plan"
}

check "version prints this program's line, then systemd's" versions

# 1. a dry run on a fresh project writes nothing
write 1 ""
check "up --dry-run on a fresh project exits 0" sc up --dry-run
check "  and writes no render directory" test ! -e .systemd-compose
check "  and registers nothing" test "$(links)" = 0

check "run before any up works from the yaml" shows 'job ran' sc run job
check "  and leaves nothing loaded (no on-demand slice)" test "$(units)" = 0

# 2. up: everything declared and enabled comes up
check "up exits 0" sc up
for u in web.service web.socket job.timer; do check "$u is active" active "$name-$u"; done
check "the slice is active" active "$name.slice"
check "  and carries the project's memory cap" test "$(systemctl --user show -p MemoryMax --value "$name.slice")" = 268435456
check "the target is active" active "$name.target"
check "the first up's build ran in the slice" shows "/$name.slice/" cat built
check "a disabled profile is not registered" test ! -e "$unitdir/$name-debug.service"
check "ps shows HEALTH ready" shows ' ready ' sc ps
check "ls lists the project" shows "^$name " "$SC" ls
sleep 1
check "the service saw .env, a specifier and its socket" shows "web X=1 G=hello RT=$(runtime_dir)/$name fds=1" sc logs --no-log-prefix web

# 3. a second up changes nothing
p0=$(pid "$name-web.service")
check "a second up reports every row unchanged" all_unchanged
check "  and names the build up to date" shows '^  build job: up to date, ' sc up --dry-run # row grammar
check "  and restarts nothing" test "$(pid "$name-web.service")" = "$p0"

# 4. a change restarts the changed service only
write 2 ""
check "up after an edit exits 0" sc up
check "  web was restarted" test "$(pid "$name-web.service")" != "$p0"
check "  and runs the new definition" sc run web sh -c 'test "$X" = 2'

# 4b. a later up's build runs under that up's limits (the rule: up in
# cli.go, before its builds)
check "the first build saw the 256M cap" test "$(sed -n 2p built)" = 268435456
write 2 "" 512M
check "up --build under a raised cap exits 0" sc up --build
check "  and the build saw the new cap" test "$(sed -n 2p built)" = 536870912

# 5. run and exec
check "run carries the exit code" exits 3 run web sh -c 'exit 3'
check "run -e beats the service's value" sc run -e X=9 web sh -c 'test "$X" = 9'
check "run lands in the project's slice" shows "/$name.slice/" sc run -T web cat /proc/self/cgroup
check "run job runs the job's own command" shows 'job ran' sc run job
check "exec needs a command" refuses exec web

# 6. profiles
check "--profile debug up registers debug" sc --profile debug up
check "  debug is active" active "$name-debug.service"
check "a bare stop stops every profile" sc stop
check "  debug included" inactive "$name-debug.service"
check "start brings the enabled set back" sc start
check "  web is active again" active "$name-web.service"

# 7. a dropped service is retired: by up (an active one only with --force),
# and by down; debug, of an inactive profile, is still registered from 6.
# Two extras, so a refusal that cut the plan short would lose the second.
extra="  extra:
    command: sleep infinity
  extra2:
    command: sleep infinity"
write 2 "$extra"
check "up with two extra services" sc up
write 2 ""
rm -f built # so the refused up also plans a build
refused="orphan *ACTIVE, not in the yaml: refused without --force"
check "up refuses to retire the running extras" refuses up
check "  and its plan shows the first orphan" says "^  $name-extra.service *$refused" sc up # row grammar
check "  and the second" says "^  $name-extra2.service *$refused" sc up # row grammar
check "  and the build it would run" says '^  build job: 1 step' sc up # row grammar
check "  up --dry-run refuses too, with the same plan" says "^  $name-extra2.service *$refused" sc up --dry-run # row grammar
check "  built nothing" test ! -e built
check "  and leaves the extras registered" test -e "$unitdir/$name-extra.service"
check "up --force retires them" sc up --force
check "  extra's link is gone" test ! -e "$unitdir/$name-extra.service"
check "  extra2's link is gone" test ! -e "$unitdir/$name-extra2.service"
write 2 "$extra"
check "up with the extras again" sc up
write 2 ""
check "a bare down after dropping them exits 0" sc down
check "  every link is gone, debug's too" test "$(links)" = 0

check "run after a down works from the yaml" shows 'job ran' sc run job

# 8. nothing left behind (no on-demand slice from that run either)
sleep 1
check "nothing of the project is loaded" test "$(units)" = 0

echo
if [ "$fails" -gt 0 ]; then echo "$fails FAILED"; exit 1; fi
echo "all ok"
